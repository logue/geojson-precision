{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "include": ["src/env.d.ts", "src/**/*"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ESNext"]
  }
}
