#!/usr/bin/env node

import { readFile, writeFile } from 'node:fs';
import { join } from 'node:path';

import { Command } from 'commander';

import { parse } from '../dist/index.es.js';

const command = new Command();

command
  .usage('[coordinatePrecision] [extrasPrecision] input output')
  .option(
    '-p, --precision [coordinatePrecision]',
    'Output precision, defaults to 6',
    '6'
  )
  .option(
    '-e, --extras-precision [extrasPrecision]',
    'Output precision for extra coordinates beyond X and Y, such as Z. Defaults to 2',
    '2'
  )
  .option('--ignore-point [ignorePoint]', 'Ignore Points.')
  .option('--ignore-line-string [ignoreLineString]', 'Ignore LineStrings.')
  .option('--ignore-polygon [ignorePolygon]', 'Ignore Polygons.')
  .option(
    '--remove-duplicates [removeDuplicates]',
    'Remove consecutive duplicate points.'
  )
  .parse(process.argv);

if (command.args.length < 2) {
  console.error('An input and output file is required');
  command.help();
} else {
  const resolvePath = path =>
    path.indexOf('/') < 0 ? join(process.cwd(), path) : path;

  const inputPath = resolvePath(command.args[0]);
  const outputPath = resolvePath(command.args[1]);

  readFile(inputPath, (readError, data) => {
    if (readError) {
      console.error(readError);
      command.help();
      return;
    }

    const parsed = parse(
      JSON.parse(data.toString()),
      Number(command.getOptionValue('precision')),
      Number(command.getOptionValue('extrasPrecision')),
      {
        ignorePoint: Boolean(command.getOptionValue('ignorePoint')),
        ignoreLineString: Boolean(command.getOptionValue('ignoreLineString')),
        ignorePolygon: Boolean(command.getOptionValue('ignorePolygon')),
        removeDuplicates: Boolean(command.getOptionValue('removeDuplicates')),
      }
    );

    writeFile(outputPath, JSON.stringify(parsed), writeError => {
      if (writeError) {
        console.error(writeError);
        command.help();
        return;
      }
      process.exit();
    });
  });
}
